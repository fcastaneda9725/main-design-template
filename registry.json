{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "main-design-template",
  "homepage": "https://main-design-template.vercel.app",
  "items": [
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "auth",
      "type": "registry:base",
      "title": "Auth",
      "description": "better-auth + drizzleAdapter, solo cableado (sin UI de login/registro — eso depende de la marca). Email+password con el plugin admin() para roles. sendResetPassword construye el link directo con el token crudo, no la URL de better-auth, para evitar que quede atrapado en el frame sandboxed de clientes de correo. Requiere `db`. El envío real del correo de reset es un stub hasta que se instale `email`.",
      "registryDependencies": [
        "db"
      ],
      "dependencies": [
        "better-auth@1.6.22",
        "@better-auth/utils@^0.4.2"
      ],
      "files": [
        {
          "path": "db/schema/auth.ts",
          "target": "db/schema/auth.ts",
          "type": "registry:file"
        },
        {
          "path": "lib/auth/server.ts",
          "target": "lib/auth/server.ts",
          "type": "registry:file"
        },
        {
          "path": "lib/auth/client.ts",
          "target": "lib/auth/client.ts",
          "type": "registry:file"
        },
        {
          "path": "modules/auth/SKILL.md",
          "target": ".claude/skills/auth/SKILL.md",
          "type": "registry:file"
        }
      ]
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "base",
      "type": "registry:base",
      "title": "Base",
      "description": "Núcleo invariante de todo proyecto: env.ts con Zod, tipo Result<T>, código de referencia determinista para errores, captura de errores de servidor (instrumentation.ts), los tres estados obligatorios de vista (vacío/error/sin permisos) y AGENTS.md con las convenciones del kit más encabezados TODO(proyecto) para lo específico del cliente. No trae cn() — lo instala `shadcn init` — ni hornea paleta, eso es el módulo `theme-<cliente>`.",
      "dependencies": [
        "zod@^4",
        "nanoid"
      ],
      "registryDependencies": [
        "button"
