{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "base",
  "type": "registry:base",
  "title": "Base",
  "description": "Núcleo invariante de todo proyecto: env.ts con Zod, tipo Result<T>, código de referencia determinista para errores, captura de errores de servidor (instrumentation.ts), los tres estados obligatorios de vista (vacío/error/sin permisos) y AGENTS.md con las convenciones del kit más encabezados TODO(proyecto) para lo específico del cliente. No trae cn() — lo instala `shadcn init` — ni hornea paleta, eso es el módulo `theme-<cliente>`.",
  "dependencies": ["zod@^4", "nanoid"],
  "registryDependencies": ["button"],
  "files": [
    { "path": "lib/result.ts", "target": "lib/result.ts", "type": "registry:file" },
    { "path": "lib/env.ts", "target": "lib/env.ts", "type": "registry:file" },
    { "path": "lib/errors/reference-code.ts", "target": "lib/errors/reference-code.ts", "type": "registry:file" },
    { "path": "instrumentation.ts", "target": "instrumentation.ts", "type": "registry:file" },
    { "path": "components/states/empty-state.tsx", "target": "components/states/empty-state.tsx", "type": "registry:component" },
    { "path": "components/states/error-state.tsx", "target": "components/states/error-state.tsx", "type": "registry:component" },
    { "path": "components/states/forbidden-state.tsx", "target": "components/states/forbidden-state.tsx", "type": "registry:component" },
    { "path": "app/error.tsx", "target": "app/error.tsx", "type": "registry:page" },
    { "path": "AGENTS.md", "target": "AGENTS.md", "type": "registry:file" }
  ]
}
