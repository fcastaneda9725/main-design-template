      { "token": "h2", "sizeDesktop": 30, "sizeMobile": 24, "lineHeight": 1.18, "tracking": "0", "family": "display", "weight": 400, "use": "Bloques dentro de una pantalla." },
      { "token": "h3", "sizeDesktop": 22, "sizeMobile": 20, "lineHeight": 1.25, "tracking": "0", "family": "interface", "weight": 500, "use": "Encabezado de panel y modal." },
      { "token": "body-lg", "sizeDesktop": 18.5, "sizeMobile": 17, "lineHeight": 1.7, "tracking": "0", "family": "interface", "weight": 400, "use": "Bajada de hero y párrafos de apertura." },
