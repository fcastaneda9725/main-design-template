      "strong": "#D4D4D8"
    },
    "accent": {
      "default": "#2563EB",
      "hover": "#1D4ED8",
      "quiet": "#DBEAFE"
    },
    "state": {
      "success": "#16A34A",
      "warning": "#D97706",
      "error": "#DC2626",
