  "spacing": {
    "0.5": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24,
    "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96, "30": 120
  },
