  "motion": {
    "duration": { "instant": 120, "fast": 180, "base": 240, "slow": 320 },
    "easing": { "standard": "cubic-bezier(.2,.6,.2,1)", "exit": "cubic-bezier(.4,0,1,1)" }
  }
