      { "token": "body-strong", "sizeDesktop": 15.5, "sizeMobile": 15.5, "lineHeight": 1.5, "tracking": "0", "family": "interface", "weight": 600, "use": "Labels de formulario y celdas clave." },
      { "token": "body-sm", "sizeDesktop": 13.5, "sizeMobile": 13.5, "lineHeight": 1.55, "tracking": "0", "family": "interface", "weight": 400, "use": "Ayuda contextual, metadatos, notas al pie." },
      { "token": "mono-data", "sizeDesktop": 15, "sizeMobile": 15, "lineHeight": 1.4, "tracking": "0.02em", "family": "mono", "weight": 500, "use": "Folios y montos. Siempre tabular." },
      { "token": "mono-meta", "sizeDesktop": 12, "sizeMobile": 12, "lineHeight": 1.6, "tracking": "0.04em", "family": "mono", "weight": 400, "use": "Fecha, hora y autor en bitácoras." },
      { "token": "eyebrow", "sizeDesktop": 11, "sizeMobile": 11, "lineHeight": 1.4, "tracking": "0.26em", "family": "mono", "weight": 500, "use": "Etiqueta de sección. Máximo una por bloque." }
    ]
