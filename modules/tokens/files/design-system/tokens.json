    "none": 0, "xs": 2, "sm": 4, "md": 6, "lg": 10, "full": 999
  },
  "shadow": {
    "elev-0": "none",
    "elev-1": "0 1px 2px rgba(0,0,0,.06)",
    "elev-2": "0 2px 10px rgba(0,0,0,.10)",
    "elev-3": "0 18px 48px rgba(0,0,0,.16)"
  },
  "zIndex": {
    "base": 0, "sticky": 10, "dropdown": 20, "drawer": 30, "modal": 40, "toast": 50, "tooltip": 60, "cookie": 70
  },
  "breakpoint": {
    "sm": 390, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1440
